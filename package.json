{
  "name": "job-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:agent-credential-safety": "node scripts/checks/agent-credential-safety.test.mjs",
    "check:agent-credentials": "node scripts/checks/agent-credential-safety.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "agent:debug": "cargo run --manifest-path src-tauri/Cargo.toml --features agent-debug --bin agent-debug",
    "smoke:search-run": "cargo run --manifest-path src-tauri/Cargo.toml -- dev-search-run-smoke",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json",
    "typecheck:test": "tsc -b tsconfig.test.json",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest --watch",
    "check:frontend": "npm run typecheck && npm run typecheck:test && npm run test:frontend && npm run build"
  },
  "dependencies": {
